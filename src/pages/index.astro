---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import Tags from '../components/Tags.astro';
import { profile, intro, experience, interests, principles, education } from '../data/profile';

const contactLinks = [
	{ label: 'Email', href: profile.links.email && `mailto:${profile.links.email}` },
	{ label: 'GitHub', href: profile.links.github },
	{ label: 'LinkedIn', href: profile.links.linkedin },
].filter((link) => link.href);

const year = new Date().getFullYear();
---

<Layout>
	<Header />

	<main id="main" class="mx-auto max-w-3xl px-6">
		<!-- Hero -->
		<section id="top" class="pt-20 pb-16 sm:pt-28">
			<p class="mb-5 inline-flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
				<span class="relative flex size-2">
					<span class="absolute inline-flex size-full animate-ping rounded-full bg-teal-500 opacity-60 motion-reduce:hidden"></span>
					<span class="relative inline-flex size-2 rounded-full bg-teal-500"></span>
				</span>
				{profile.location}
			</p>
			<h1 class="text-4xl font-bold text-balance text-zinc-900 sm:text-5xl dark:text-zinc-50">
				{profile.name}
			</h1>
			<p class="mt-4 text-lg text-balance text-zinc-600 sm:text-xl dark:text-zinc-400">
				{profile.role}. {profile.tagline}
			</p>

			<div class="mt-8 space-y-4 leading-relaxed">
				{intro.map((paragraph) => <p>{paragraph}</p>)}
			</div>

			{
				contactLinks.length > 0 && (
					<ul class="mt-8 flex flex-wrap gap-3">
						{contactLinks.map((link, i) => (
							<li>
								<a
									href={link.href}
									target={link.href!.startsWith('http') ? '_blank' : undefined}
									rel={link.href!.startsWith('http') ? 'noopener noreferrer' : undefined}
									class:list={[
										'inline-flex h-10 items-center rounded-md px-4 text-sm font-medium transition-colors',
										i === 0
											? 'bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-zinc-50 dark:text-zinc-900 dark:hover:bg-zinc-200'
											: 'border border-zinc-300 text-zinc-800 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-900',
									]}
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</section>

		<!-- Experience -->
		<Section id="work" title="Work">
			<ol class="space-y-14">
				{
					experience.map((job) => {
						const link = job.linkKey && profile.links[job.linkKey];
						return (
							<li class="grid gap-4 sm:grid-cols-[10rem_1fr] sm:gap-8">
								<div class="font-mono text-xs leading-6 text-zinc-500 dark:text-zinc-400">
									{job.period && <p>{job.period}</p>}
									{job.meta && <p>{job.meta}</p>}
								</div>
								<div>
									<h3 class="font-semibold text-zinc-900 dark:text-zinc-50">
										{job.title}
										<span class="text-zinc-400 dark:text-zinc-500"> · </span>
										{link ? (
											<a
												href={link}
												target="_blank"
												rel="noopener noreferrer"
												class="text-teal-700 underline-offset-4 hover:underline dark:text-teal-400"
											>
												{job.org}
											</a>
										) : (
											job.org
										)}
									</h3>

									{job.progression && (
										<ol class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400">
											{job.progression.map((step, i) => (
												<li class="flex items-center gap-2">
													{i > 0 && <span aria-hidden="true">→</span>}
													<span>
														<span class="text-zinc-700 dark:text-zinc-300">{step.role}</span> ({step.date})
													</span>
												</li>
											))}
										</ol>
									)}

									<div class="mt-4 space-y-4 leading-relaxed">
										{job.body.map((paragraph) => <p>{paragraph}</p>)}
									</div>

									{job.tags && (
										<div class="mt-5">
											<Tags tags={job.tags} />
										</div>
									)}
								</div>
							</li>
						);
					})
				}
			</ol>
		</Section>

		<!-- Applied AI and IoT -->
		<Section id="interests" title="Applied AI & IoT">
			<p class="mb-10 text-lg leading-relaxed text-zinc-800 dark:text-zinc-200">{interests.lead}</p>
			<div class="grid gap-4">
				{
					interests.areas.map((area) => (
						<article class="rounded-xl border border-zinc-200 p-6 transition-colors hover:border-zinc-300 dark:border-zinc-800 dark:hover:border-zinc-700">
							<h3 class="font-semibold text-zinc-900 dark:text-zinc-50">{area.title}</h3>
							<p class="mt-3 leading-relaxed">{area.body}</p>
							<div class="mt-5">
								<Tags tags={area.tags} />
							</div>
						</article>
					))
				}
			</div>
		</Section>

		<!-- Principles -->
		<Section id="approach" title="How I like to build">
			<ol class="grid gap-10">
				{
					principles.map((principle, i) => (
						<li class="grid gap-2 sm:grid-cols-[3rem_1fr]">
							<span class="font-mono text-sm text-teal-700 dark:text-teal-400">0{i + 1}</span>
							<div>
								<h3 class="font-semibold text-zinc-900 dark:text-zinc-50">{principle.title}</h3>
								<p class="mt-2 leading-relaxed">{principle.body}</p>
							</div>
						</li>
					))
				}
			</ol>
		</Section>

		<!-- Education -->
		<Section id="education" title="Education">
			<div class="grid gap-4 sm:grid-cols-[10rem_1fr] sm:gap-8">
				<p class="font-mono text-xs leading-6 text-zinc-500 dark:text-zinc-400">{education.period}</p>
				<div>
					<h3 class="font-semibold text-zinc-900 dark:text-zinc-50">{education.degree}</h3>
					<p class="mt-1">{education.school}</p>
				</div>
			</div>
		</Section>
	</main>

	<footer class="mx-auto max-w-3xl px-6">
		<div
			class="flex flex-col gap-4 border-t border-zinc-200 py-10 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between dark:border-zinc-800 dark:text-zinc-400"
		>
			<p>© {year} {profile.name}</p>
			{
				contactLinks.length > 0 && (
					<ul class="flex gap-5">
						{contactLinks.map((link) => (
							<li>
								<a href={link.href} class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-50">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</footer>
</Layout>
