---
import { profile } from '../data/profile';

// Inner SVG markup for each icon (Lucide, 24×24, stroke-based).
const icons = {
	projects:
		'<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
	education:
		'<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
	experience: '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
	contact: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
	github:
		'<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
	linkedin:
		'<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
	// Filled glyph (not a stroke icon); rendered with fill="currentColor".
	x: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
	email: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
};

const nav = [
	{ href: '#projects', label: 'Projects', icon: icons.projects },
	{ href: '#experience', label: 'Experience', icon: icons.experience },
	{ href: '#education', label: 'Education', icon: icons.education },
	{ href: '#contact', label: 'Contact', icon: icons.contact },
];

const social = [
	{ href: profile.links.github, label: 'GitHub', icon: icons.github },
	{ href: profile.links.linkedin, label: 'LinkedIn', icon: icons.linkedin },
	{ href: profile.links.x, label: 'X', icon: icons.x, filled: true },
	{ href: profile.links.email && `mailto:${profile.links.email}`, label: 'Email', icon: icons.email },
].filter((link) => link.href);

const item =
	'group relative grid size-8 place-items-center rounded-xl text-zinc-500 transition duration-200 ease-out hover:-translate-y-1 hover:scale-110 hover:bg-zinc-100 hover:text-zinc-900 motion-reduce:transform-none sm:size-10 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-50';
const tooltip =
	'pointer-events-none absolute -top-9 left-1/2 hidden -translate-x-1/2 translate-y-1 rounded-md bg-zinc-900 px-2 py-1 text-xs font-medium whitespace-nowrap text-zinc-50 opacity-0 shadow-sm transition duration-150 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 sm:block dark:bg-zinc-50 dark:text-zinc-900';
const divider = 'mx-1 h-6 w-px self-center bg-zinc-200 dark:bg-zinc-800';
---

<nav
	aria-label="Primary"
	class="dock-in fixed bottom-[max(1rem,env(safe-area-inset-bottom))] left-1/2 z-40 -translate-x-1/2"
>
	<ul
		id="dock"
		class="flex h-[46px] items-end gap-1 rounded-2xl border sm:h-[54px] border-zinc-200/80 bg-white/75 p-1.5 shadow-lg shadow-zinc-900/5 backdrop-blur-xl dark:border-zinc-800/80 dark:bg-zinc-900/75 dark:shadow-black/30"
	>
		<li class="self-center">
			<a
				href="#top"
				class="flex h-8 items-center rounded-xl px-2.5 font-display text-sm font-bold whitespace-nowrap text-zinc-900 transition-colors hover:bg-zinc-100 sm:h-10 sm:px-3 sm:text-base dark:text-zinc-50 dark:hover:bg-zinc-800"
			>
				<span class="text-zinc-400 dark:text-zinc-500">@</span>{profile.handle}<span
					class="text-teal-600 dark:text-teal-400">.</span
				>
			</a>
		</li>

		<li aria-hidden="true" class={divider}></li>

		{
			nav.map((link) => (
				<li>
					<a href={link.href} aria-label={link.label} data-dock-link data-mag class={item}>
						<svg class="size-4.5 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={link.icon} />
						<span class="absolute -bottom-0.5 hidden size-1 rounded-full bg-teal-500 group-aria-current:block" aria-hidden="true" />
						<span class={tooltip} aria-hidden="true">{link.label}</span>
					</a>
				</li>
			))
		}

		{
			social.length > 0 && (
				<li aria-hidden="true" class:list={[divider, 'hidden sm:block']} />
			)
		}
		{
			social.map((link) => (
				<li class="hidden sm:block">
					<a
						href={link.href}
						aria-label={link.label}
						target={link.href!.startsWith('http') ? '_blank' : undefined}
						rel={link.href!.startsWith('http') ? 'noopener noreferrer' : undefined}
						data-mag
						class={item}
					>
						{'filled' in link ? (
							<svg class="size-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={link.icon} />
						) : (
							<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={link.icon} />
						)}
						<span class={tooltip} aria-hidden="true">{link.label}</span>
					</a>
				</li>
			))
		}

		<li aria-hidden="true" class={divider}></li>

		<li>
			<button id="theme-toggle" type="button" aria-label="Toggle dark mode" data-mag class={item}>
				<svg class="size-4.5 sm:size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
				<svg class="hidden size-4.5 sm:size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
				</svg>
				<span class={tooltip} aria-hidden="true">Theme</span>
			</button>
		</li>
	</ul>
</nav>

<script>
	const root = document.documentElement;
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Theme toggle: the new theme spreads out in a circle from the button,
	// using the View Transitions API where the browser supports it.
	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', async () => {
		const apply = () => {
			const dark = root.classList.toggle('dark');
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {}
		};

		if (!document.startViewTransition || reduceMotion) {
			apply();
			return;
		}

		const rect = toggle.getBoundingClientRect();
		const x = rect.left + rect.width / 2;
		const y = rect.top + rect.height / 2;
		const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

		const transition = document.startViewTransition(apply);
		await transition.ready;
		root.animate(
			{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
			{ duration: 550, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
		);
	});

	// Dock magnification: icons grow with the cursor's proximity, like the
	// macOS dock. Mouse and trackpad only; off for reduced motion.
	const dock = document.getElementById('dock');
	if (dock && !reduceMotion && matchMedia('(hover: hover) and (pointer: fine)').matches) {
		const items = [...dock.querySelectorAll<HTMLElement>('[data-mag]')];
		const BASE = 40;
		const MAX = 54;
		const RANGE = 110;
		let frame = 0;
		let pointerX = 0;

		dock.classList.add('dock-magnify');

		const update = () => {
			frame = 0;
			for (const el of items) {
				const rect = el.getBoundingClientRect();
				const distance = Math.abs(pointerX - (rect.left + rect.width / 2));
				const t = Math.max(0, 1 - distance / RANGE);
				const size = BASE + (MAX - BASE) * (0.5 - Math.cos(Math.PI * t) / 2);
				el.style.width = el.style.height = `${size.toFixed(1)}px`;
			}
		};

		dock.addEventListener('pointermove', (event) => {
			pointerX = event.clientX;
			if (!frame) frame = requestAnimationFrame(update);
		});
		dock.addEventListener('pointerleave', () => {
			cancelAnimationFrame(frame);
			frame = 0;
			for (const el of items) el.style.width = el.style.height = '';
		});
	}

	// Mark the dock item for the section currently in view.
	const links = new Map<string, HTMLAnchorElement>();
	document.querySelectorAll<HTMLAnchorElement>('[data-dock-link]').forEach((link) => {
		links.set(link.hash.slice(1), link);
	});

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				links.forEach((link, id) => {
					if (id === entry.target.id) link.setAttribute('aria-current', 'true');
					else link.removeAttribute('aria-current');
				});
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);

	document.querySelectorAll('main section[id]').forEach((section) => {
		if (section.id === 'top') {
			// Clear the indicator when scrolled back up to the hero.
			new IntersectionObserver(([entry]) => {
				if (entry.isIntersecting) links.forEach((link) => link.removeAttribute('aria-current'));
			}, { rootMargin: '-45% 0px -50% 0px' }).observe(section);
		} else {
			observer.observe(section);
		}
	});
</script>
